# Copy this file to .env and fill in your own values.
# Never commit a real .env file.

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_API_KEY_HERE

# PubMed / NCBI Entrez Configuration
# Email is required by NCBI for contact / rate limiting
PUBMED_EMAIL=your_email@example.com
PUBMED_API_KEY=YOUR_PUBMED_API_KEY_HERE

# Optional: other literature APIs (only if you use those features)
# WOS_API_KEY=YOUR_WOS_API_KEY_HERE
# SCOPUS_API_KEY=YOUR_SCOPUS_API_KEY_HERE

# Optional: local paths for validation / comparison features
# ENDNOTE_FILE_PATH=path/to/your/endnote/library.xml
# MANUAL_QUERY_PATH=path/to/your/manual/query.docx
# MANUAL_PDF_DIR=data/manual_pdfs
